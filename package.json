{
  "name": "effect-harness",
  "version": "0.8.1",
  "description": "Durable AI conversations with Effect services, schema-backed state, and scoped local execution.",
  "homepage": "https://github.com/julia-script/effect-harness#readme",
  "bugs": {
    "url": "https://github.com/julia-script/effect-harness/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/effect-harness.git"
  },
  "files": [
    "dist",
    "src",
    "!src/**/test/**",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./storage/schema": {
      "types": "./dist/storage/schema/index.d.ts",
      "default": "./dist/storage/schema/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    },
    "./delta": {
      "types": "./dist/delta/index.d.ts",
      "default": "./dist/delta/index.js"
    },
    "./task": {
      "types": "./dist/task/index.d.ts",
      "default": "./dist/task/index.js"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "default": "./dist/harness/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./credentials": {
      "types": "./dist/credentials/index.d.ts",
      "default": "./dist/credentials/index.js"
    },
    "./credentials/bun": {
      "types": "./dist/credentials/bun/index.d.ts",
      "default": "./dist/credentials/bun/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./tool": {
      "types": "./dist/tool/index.d.ts",
      "default": "./dist/tool/index.js"
    },
    "./coding": {
      "types": "./dist/coding/index.d.ts",
      "default": "./dist/coding/index.js"
    },
    "./coding/bun": {
      "types": "./dist/coding/bun/index.d.ts",
      "default": "./dist/coding/bun/index.js"
    },
    "./coding/sharp": {
      "types": "./dist/coding/sharp/index.d.ts",
      "default": "./dist/coding/sharp/index.js"
    },
    "./codemode": {
      "types": "./dist/codemode/index.d.ts",
      "default": "./dist/codemode/index.js"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "default": "./dist/openai/index.js"
    },
    "./openai/adapter": {
      "types": "./dist/openai/adapter/index.d.ts",
      "default": "./dist/openai/adapter/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic/index.d.ts",
      "default": "./dist/anthropic/index.js"
    },
    "./anthropic/adapter": {
      "types": "./dist/anthropic/adapter/index.d.ts",
      "default": "./dist/anthropic/adapter/index.js"
    },
    "./accounts": {
      "types": "./dist/accounts/index.d.ts",
      "default": "./dist/accounts/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "oxlint --disable-nested-config .",
    "format": "oxfmt --write .",
    "check": "oxfmt --check . && oxlint --disable-nested-config . && bun run typecheck",
    "check:write": "oxfmt --write . && oxlint --disable-nested-config --fix .",
    "setup": "effect-tsgo patch --oxlint",
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p examples/cloudflare",
    "example:cloudflare": "alchemy dev examples/cloudflare/alchemy.run.ts",
    "test": "bun test src",
    "test:package": "bun scripts/check-package.ts",
    "prepack": "bun run build",
    "changeset": "changeset",
    "check:changesets": "changeset status --since=origin/main",
    "version:packages": "changeset version && bun install --lockfile-only --ignore-scripts && bun run format",
    "release": "changeset publish"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.3.0",
    "diff": "8.0.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@effect/ai-anthropic": "4.0.5",
    "@effect/ai-openai": "4.0.5",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/sql-pglite": "4.0.5",
    "@effect/sql-sqlite-bun": "4.0.5",
    "@effect/sql-sqlite-do": "4.0.5",
    "@effect/tsgo": "0.53.3",
    "@types/bun": "1.4.3",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "sharp": "0.34.5",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@effect/ai-anthropic": "4.0.5",
    "@effect/ai-openai": "4.0.5",
    "@effect/sql-sqlite-do": "4.0.5",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.5",
    "sharp": "0.34.5"
  },
  "peerDependenciesMeta": {
    "@effect/ai-anthropic": {
      "optional": true
    },
    "@effect/ai-openai": {
      "optional": true
    },
    "@effect/sql-sqlite-do": {
      "optional": true
    },
    "alchemy": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.2"
}

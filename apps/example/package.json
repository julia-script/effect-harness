{
  "name": "@effect-harness/example",
  "private": true,
  "type": "module",
  "scripts": {
    "dependencies:build": "bun run --cwd ../../packages/effect-harness build",
    "typecheck": "bun run dependencies:build && tsc --noEmit",
    "build": "bun run dependencies:build && tsc",
    "reproduce:unknown-tool": "bun run dependencies:build && bun src/reproduceUnknownTool.ts",
    "test": "bunx --bun vitest run --config vitest.config.ts --root ../.. apps/example/test && bun dist/main.js"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.1",
    "@effect/sql-sqlite-bun": "4.0.1",
    "effect": "catalog:",
    "effect-harness": "workspace:*"
  }
}

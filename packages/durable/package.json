{
  "name": "@effect-harness/durable",
  "version": "0.0.0",
  "files": [
    "dist",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage/State": null,
    "./storage/Backend": null,
    "./storage/State/*": null,
    "./storage/Backend/*": null,
    "./internal": null,
    "./internal/*": null,
    "./storage/internal": null,
    "./storage/internal/*": null,
    "./workflow/internal": null,
    "./workflow/internal/*": null,
    "./testing/internal": null,
    "./testing/internal/*": null,
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "default": "./dist/workflow/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./storage/SqlStore": null,
    "./storage/SqliteStore": null,
    "./storage/BunSqliteStore": null,
    "./storage/NodeSqliteStore": null,
    "./storage/Sqlite": null,
    "./storage/Bun": null,
    "./storage/Node": null,
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "cd ../.. && vitest run packages/durable/test",
    "typetest": "cd ../.. && tstyche packages/durable/typetest"
  },
  "dependencies": {
    "@effect-harness/harness": "workspace:^"
  },
  "devDependencies": {
    "@effect/sql-sqlite-bun": "4.0.1",
    "@effect/sql-sqlite-node": "4.0.1",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.1"
  }
}

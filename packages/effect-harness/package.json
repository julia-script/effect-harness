{
  "name": "effect-harness",
  "version": "0.2.1",
  "description": "Embedded durable AI conversations with Effect, atomic persistence and phase tasks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/effect-harness.git",
    "directory": "packages/effect-harness"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "default": "./dist/env/index.js"
    },
    "./env/internal/*": null,
    "./tools/internal/*": null,
    "./internal/*": null,
    "./internal": null,
    "./env/internal": null,
    "./tools/internal": null,
    "./provider-openai": {
      "types": "./dist/provider-openai/index.d.ts",
      "default": "./dist/provider-openai/index.js"
    },
    "./provider-openai/*": {
      "types": "./dist/provider-openai/*.d.ts",
      "default": "./dist/provider-openai/*.js"
    },
    "./provider-anthropic": {
      "types": "./dist/provider-anthropic/index.d.ts",
      "default": "./dist/provider-anthropic/index.js"
    },
    "./provider-anthropic/*": {
      "types": "./dist/provider-anthropic/*.d.ts",
      "default": "./dist/provider-anthropic/*.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./storage/internal": null,
    "./storage/internal/*": null
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "cd ../.. && vitest run packages/effect-harness/test",
    "typetest": "cd ../.. && tstyche packages/effect-harness/typetest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@effect/ai-anthropic": "4.0.1",
    "@effect/ai-openai": "4.0.1",
    "diff": "^8.0.2"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.1",
    "@effect/platform-node": "4.0.1",
    "@effect/sql-sqlite-bun": "4.0.1",
    "@effect/sql-sqlite-node": "4.0.1",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-bun": "4.0.1",
    "@effect/platform-node": "4.0.1",
    "@effect/sql-sqlite-bun": "4.0.1",
    "@effect/sql-sqlite-node": "4.0.1",
    "effect": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    },
    "@effect/sql-sqlite-bun": {
      "optional": true
    },
    "@effect/sql-sqlite-node": {
      "optional": true
    }
  }
}

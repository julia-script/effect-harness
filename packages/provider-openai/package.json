{
  "name": "@effect-harness/provider-openai",
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "cd ../.. && vitest run packages/provider-openai/test",
    "typetest": "cd ../.. && tstyche packages/provider-openai/typetest"
  },
  "dependencies": {
    "@effect-harness/auth": "workspace:^",
    "@effect-harness/harness": "workspace:^",
    "@effect/ai-openai": "4.0.1"
  },
  "devDependencies": {
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.1"
  }
}

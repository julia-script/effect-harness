{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "effect-harness": ["./packages/effect-harness/src/index.ts"],
      "effect-harness/*": ["./packages/effect-harness/src/*.ts"],
      "effect-harness/provider-openai": ["./packages/effect-harness/src/provider-openai/index.ts"],
      "effect-harness/provider-anthropic": [
        "./packages/effect-harness/src/provider-anthropic/index.ts"
      ],
      "effect-harness/provider-auth": ["./packages/effect-harness/src/provider-auth/index.ts"],
      "effect-harness/provider-auth-node": [
        "./packages/effect-harness/src/provider-auth-node/index.ts"
      ],
      "effect-harness/provider-openai-codex": [
        "./packages/effect-harness/src/provider-openai-codex/index.ts"
      ]
    }
  },
  "include": [
    "packages/effect-harness/test/**/*.ts",
    "packages/effect-harness/integration/**/*.ts",
    "apps/*/test/**/*.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ]
}

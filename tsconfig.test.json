{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "effect-harness": ["./packages/effect-harness/src/index.ts"],
      "effect-harness/*": ["./packages/effect-harness/src/*.ts"],
      "effect-harness/tools": ["./packages/effect-harness/src/tools/index.ts"],
      "effect-harness/testing": ["./packages/effect-harness/src/testing/index.ts"],
      "effect-harness/env": ["./packages/effect-harness/src/env/index.ts"],
      "effect-harness/provider-openai": ["./packages/effect-harness/src/provider-openai/index.ts"],
